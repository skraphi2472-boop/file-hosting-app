# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/file_hosting
DB_HOST=localhost
DB_PORT=5432
DB_NAME=file_hosting
DB_USER=postgres
DB_PASSWORD=password

# Session
SESSION_SECRET=your-super-secret-key-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=file-hosting-bucket

# Security
MAX_FILE_SIZE=5368709120
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,video/mp4,video/webm,audio/mpeg,audio/wav,text/plain,text/csv
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Retention
FILE_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Admin
ADMIN_RETENTION_DAYS=7
